# ── Backend ─────────────────────────────────────────────────────
APP_ID=your-app-id
APP_SECRET=your-app-secret

# ── Database ───────────────────────────────────────────────────
# Any reachable MySQL-compatible URL. If unreachable, the app runs
# on its in-memory store and labels that in the UI.
DATABASE_URL=mysql://user:password@host:3306/database

# ── Auto.dev Vehicle Listings API (server-side only) ───────────
AUTO_DEV_API_KEY=sk_ad_your_key_here

# ── Optional: MarketCheck (sell-through recents + VIN history) ─
# Free plan: 500 calls/month — https://developers.marketcheck.com
# MARKETCHECK_API_KEY=your_key_here
# Calls spent per refresh on the recents rotation (default 12):
# MARKETCHECK_REFRESH_CALLS=12

# ── Optional: parse.bot (Bring a Trailer sold comps) ───────────
# Free plan: 200 credits/month, no card — https://parse.bot
# PARSEBOT_API_KEY=your_key_here
x